# ============================================================================
# ai-extractor-api — exemplo de configuracao. Copie para .env e preencha.
# NUNCA commite o .env real.
#
# Provider/modelo/chave de IA NÃO ficam aqui: são configurados no painel admin
# (tb_aiExtractorConfigs) e chegam pelo heartbeat/bootstrap. Este .env guarda
# identidade do pool, limites e parâmetros de execução.
# ============================================================================

PORT=5555
HOST=127.0.0.1
ENVIRONMENT=dev
TRUST_PROXY=

# Allowlist de CORS separada por virgula (vazio = sem CORS habilitado)
CORS_ORIGINS=

# Chave interna exigida no header x-internal-key (obrigatoria fora de dev/TEST)
AI_INTERNAL_KEY=

# --- Pool de extractors (central -> esta instancia) ---
# DNS publico desta instancia (identidade no pool) e chave HMAC do heartbeat.
EXTRACTOR_DNS=
EXTRACTOR_KEY=
# URL do central que recebe o heartbeat (sem barra final).
EXTRACTOR_CONTROL_URL=
# Versao publicada / versao do recorte generico / capacidade concorrente.
EXTRACTOR_VERSION=dev
EXTRACTOR_CARD_TRIMMER_VERSION=trim@1
EXTRACTOR_CAPACITY=2
# Heartbeat operacional (30s recomendado; 180s e o maximo aceitavel).
EXTRACTOR_HEARTBEAT_INTERVAL_MS=30000
# Limites do corpo de /api/v1/extract (HTML descompactado / gzip / corpo total).
EXTRACTOR_MAX_HTML_BYTES=1048576
EXTRACTOR_MAX_HTML_GZIP_BYTES=524288
EXTRACTOR_BODY_LIMIT_BYTES=1258291
EXTRACTOR_MAX_SCANNED=200
EXTRACTOR_MAX_CARDS=200
EXTRACTOR_MAX_LLM_CARDS=10
EXTRACTOR_REQUEST_TIMEOUT_MS=6000
# Plataformas atendidas (vazio = todas as suportadas).
EXTRACTOR_PLATFORMS=

# Persistencia: memory (default) | mongo
AI_PERSISTENCE=memory
# URI completa tem prioridade sobre os campos MONGO_*
MONGO_URI=
MONGO_USER=
MONGO_PASSWORD=
MONGO_URL=
MONGO_ENVIRONMENT=

# Provider legado (v1): fake | http. llamacpp nativo foi removido; use http
# apontando para llama.cpp server/vLLM/Ollama.
# Versoes carimbadas (incremente ao mudar prompt/formato do pack)
PACK_VERSION=1
PROMPT_VERSION=1

LLM_PROVIDER=fake
LLM_TIMEOUT_MS=12000
LLM_CHUNK_SIZE=2
LLM_MAX_QUEUE=8
LLM_MAX_CARDS=30
LLM_MAX_TOKENS=700
LLM_TEMPERATURE=0
# Diagnostico local do modelo: loga lote/resposta (prompt com LLM_DEBUG_PROMPT).
LLM_DEBUG=false
LLM_DEBUG_PROMPT=false

# Modelo legado (v1). O modelo/provider usado na extração vem do painel admin
# (tabela tb_aiExtractorConfigs). Deixe o catálogo vazio para usar profiles/cards.json.
AI_MODEL_ID=fast
# Vazio = "<id>@1"
AI_MODEL_VERSION=

# Provider http legado (OpenAI-compatible): usado quando LLM_PROVIDER=http
LLM_HTTP_BASE_URL=
LLM_HTTP_API_KEY=
LLM_HTTP_MODEL=

# Nao persiste o pack completo por padrao (privacidade)
AI_STORE_PACKS=false
AI_ADJ_MODE=off
AI_MIN_CONFIDENCE=0.6

# ============================================================================
# Config v2 — perfis de tarefa e catálogo de modelos
# Fonte única: perfis v2. Vazio = usa profiles/cards.json do repositório.
# Para prompts longos, gere AI_PROFILES_JSON com
# `npm run config:encode -- --file profiles/cards.json` (ou use --b64).
# ============================================================================
AI_CONFIG_VERSION=2
AI_ENGINE_VERSION=2
AI_DEFAULT_PROFILE=cards
AI_DEFAULT_MODEL=fast
AI_MODE=off
AI_FAIL_OPEN=true
AI_TIMEOUT_MS=30000
AI_LEGACY_TIMEOUT_MS=5000
AI_MAX_ITEMS=30
AI_MAX_INPUT_CHARS=50000
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_CONCURRENT_PROVIDER_CALLS=4
AI_BATCH_SIZE=10
AI_LEGACY_BATCH_SIZE=2
AI_TEMPERATURE=0
AI_TOP_P=1
AI_SEED=42
AI_MAX_RETRIES=1
AI_LOG_PROMPTS=false
AI_DEBUG=false

# Cache em memória (LRU + TTL) ou off. Sem Redis.
AI_APP_CACHE=memory
AI_APP_CACHE_TTL_MS=86400000
AI_APP_CACHE_MAX=5000
AI_APP_CACHE_STORE_QUOTES=true
AI_PROMPT_CACHE=auto
AI_PROMPT_CACHE_TTL=1h
AI_PROMPT_CACHE_MAX_BLOCKS=1

# Segurança de URL de provider
AI_ALLOW_INSECURE_LLM_URL=false

# Replay (opt-in; pack só com AI_REPLAY_STORE_PACK=true)
AI_REPLAY_STORE_PACK=false
VISION_VERSION=

# Perfis e modelos (JSON em uma linha)
# Exemplo de perfil: profiles/cards.json
# Gere a linha com: npm run config:encode -- --file profiles/cards.json
# Exemplos de modelo:
# OpenAI:
# AI_MODELS_JSON=[{"id":"fast","version":"gpt-6-luna@2026-10","provider":"openai","model":"gpt-6-luna","baseUrl":"https://api.openai.com/v1","apiKeyEnv":"OPENAI_API_KEY","structuredOutput":"json_schema","promptCaching":"auto"}]
# Anthropic:
# AI_MODELS_JSON=[{"id":"claude","version":"claude-haiku-5-5@2026-10","provider":"anthropic","model":"claude-haiku-5-5","baseUrl":"https://api.anthropic.com/v1","apiKeyEnv":"ANTHROPIC_API_KEY","structuredOutput":"json_schema","promptCaching":"explicit"}]
# Gemini:
# AI_MODELS_JSON=[{"id":"gemini","version":"gemini-3.5-flash-lite@2026-10","provider":"gemini","model":"gemini-3.5-flash-lite","baseUrl":"https://generativelanguage.googleapis.com/v1beta","apiKeyEnv":"GEMINI_API_KEY","structuredOutput":"json_schema","promptCaching":"auto"}]
# Vazio = usa profiles/cards.json (perfil padrão). O provider/modelo/chave
# são configurados no painel admin, não aqui.
AI_PROFILES_JSON=
AI_MODELS_JSON=

# Visao (F5) — CLIP/SigLIP OPCIONAL para reordenar imagens JA extraidas.
# off | fake (testes) | http (servico externo POST {VISION_HTTP_URL}/score).
VISION_PROVIDER=off
VISION_HTTP_URL=
VISION_HTTP_API_KEY=
VISION_TIMEOUT_MS=1500
VISION_MIN_SCORE=0

# F6 — replay/dataset (opt-in; contém dados de produto)
AI_REPLAY_PATH=
AI_REPLAY_MAX_BYTES=50000000

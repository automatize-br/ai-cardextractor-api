# ============================================================================
# ai-extractor-api — exemplo de configuracao. Copie para .env e preencha.
# NUNCA commite o .env real.
# ============================================================================

PORT=5555
HOST=127.0.0.1
ENVIRONMENT=dev
TRUST_PROXY=

# Allowlist de CORS separada por virgula (vazio = sem CORS habilitado)
CORS_ORIGINS=

# Chave interna exigida no header x-internal-key (obrigatoria fora de dev/TEST)
AI_INTERNAL_KEY=

# Persistencia: memory (default) | mongo
AI_PERSISTENCE=memory
# URI completa tem prioridade sobre os campos MONGO_*
MONGO_URI=
MONGO_USER=
MONGO_PASSWORD=
MONGO_URL=
MONGO_ENVIRONMENT=

# Provider do modelo: fake | llamacpp | http
# Versoes carimbadas (incremente ao mudar prompt/formato do pack)
PACK_VERSION=1
PROMPT_VERSION=1

LLM_PROVIDER=fake
LLM_TIMEOUT_MS=12000
LLM_CHUNK_SIZE=2
LLM_MAX_QUEUE=8
LLM_MAX_CARDS=30
LLM_MAX_TOKENS=700
LLM_TEMPERATURE=0
# Diagnostico local do modelo: loga lote/resposta (prompt com LLM_DEBUG_PROMPT).
LLM_DEBUG=false
LLM_DEBUG_PROMPT=false

# Modelo local (llamacpp)
AI_MODEL_ID=qwen2.5-0.5b-instruct-q4_k_m
# Vazio = "<id>@1"
AI_MODEL_VERSION=
AI_MODEL_PATH=src/models/qwen2.5-0.5b-instruct-q4_k_m.gguf
AI_MODEL_CONTEXT=2048
AI_MODEL_THREADS=

# Catalogo adicional de modelos (JSON). Exemplo:
# AI_MODELS_JSON=[{"id":"qwen0.5b","provider":"llamacpp","path":"src/models/qwen2.5-0.5b-instruct-q4_k_m.gguf","contextSize":2048}]
AI_MODELS_JSON=

# Provider http (OpenAI-compatible): usado quando LLM_PROVIDER=http
LLM_HTTP_BASE_URL=
LLM_HTTP_API_KEY=
LLM_HTTP_MODEL=

# Nao persiste o pack completo por padrao (privacidade)
AI_STORE_PACKS=false
AI_ADJ_MODE=off
AI_MIN_CONFIDENCE=0.6

# Visao (F5) — CLIP/SigLIP OPCIONAL para reordenar imagens JA extraidas.
# off | fake (testes) | http (servico externo POST {VISION_HTTP_URL}/score).
VISION_PROVIDER=off
VISION_HTTP_URL=
VISION_HTTP_API_KEY=
VISION_TIMEOUT_MS=1500
VISION_MIN_SCORE=0

# F6 — replay/dataset (opt-in; contém dados de produto)
AI_REPLAY_PATH=
AI_REPLAY_MAX_BYTES=50000000

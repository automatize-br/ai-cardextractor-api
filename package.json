{
  "name": "automatize.ai-extractor-api",
  "version": "1.0.0",
  "description": "Microservico de extracao/qualificacao universal, spec-driven e provider-agnostic",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "predev": "node scripts/free-port.mjs",
    "dev:free-port": "node scripts/free-port.mjs",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "start": "node dist/server.js",
    "test": "node scripts/run-tests.mjs tests/unit tests/integration",
    "test:unit": "node scripts/run-tests.mjs tests/unit",
    "config:validate": "tsx scripts/config-validate.ts",
    "config:encode": "tsx scripts/config-encode.ts",
    "config:decode": "tsx scripts/config-decode.ts",
    "eval:adjudication": "tsx scripts/eval-adjudication.ts",
    "eval:profile": "tsx scripts/eval-profile.ts",
    "dataset:build": "tsx scripts/build-dataset.ts",
    "rollout:report": "tsx scripts/rollout-report.ts"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "compression": "^1.7.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.7.4",
    "node-html-parser": "^9.0.5",
    "undici": "^7.30.1",
    "uuid": "^11.1.0",
    "zod": "^4.6.5"
  }
}
